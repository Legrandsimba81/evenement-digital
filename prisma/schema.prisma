generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  password            String?
  image               String?
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailVerified       DateTime?
  canCreateEvents     Boolean              @default(true)
  phone               String?              @unique
  isSuperAdmin        Boolean              @default(false)
  balance             Float                @default(0)
  eventLimits         Json?
  accounts            Account[]
  comments            BlogComment[]
  likes               BlogLike[]
  posts               BlogPost[]
  competitionEntries  CompetitionEntry[]
  competitionLikes    CompetitionLike[]
  competitionComments CompetitionComment[]
  faireParts          FairePart[]
  emailVerifications  EmailVerification[]
  events              Event[]
  collaborators       EventCollaborator[]
  collaboratorLimits  Json?
  logs                EventLog[]
  notifications       Notification[]
  resetTokens         PasswordResetToken[]
  reservations        Reservation[]
  reviews             Review[]
  sessions            Session[]
  shops               Shop[]
  transactions        Transaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id                 String              @id @default(cuid())
  title              String
  type               String
  description        String?
  invitationText     String?
  program            String?
  location           String
  date               DateTime
  time               String
  imageUrl           String?
  userId             String
  slug               String              @unique
  whatsappNumber     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invitationImageUrl String?
  invitationNumber   String?
  locationAddress    String?
  locationLat        Float?
  locationLng        Float?
  locationName       String?
  locationUrl        String?
  gateSecret         String?
  theme              Json?
  thesisTitle        String?
  format             String?             @default("INVITATION")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators      EventCollaborator[]
  logs               EventLog[]
  guests             Guest[]
  messages           Message[]
  faireParts         FairePart[]         // 👈 AJOUTÉ : permet à un Event d'avoir des Faire-parts optionnels
}

model EventCollaborator {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventLog {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

model Guest {
  id               String   @id @default(cuid())
  title            String?
  firstName        String
  lastName         String
  eventId          String
  status           String?  @default("en_attente")
  invitationNumber String?
  invitationType   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  guestLevel       String?
  email            String?
  phone            String?
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([firstName, lastName, eventId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  guestName String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guestId   String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Float
  currency    String   @default("USD")
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  countryCode String?
  operator    String?
  phoneNumber String?
  proofImage  String?
  updatedAt   DateTime @updatedAt
  fullName    String?
  provider    String?
  reference   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String?
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model BlogPost {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  excerpt          String?
  content          String
  imageUrl         String?
  authorId         String
  published        Boolean       @default(false)
  publishedAt      DateTime?
  views            Int           @default(0)
  likes            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  metaTitle        String?
  metaDesc         String?
  tags             String[]
  imageOrientation String?       @default("landscape")
  images           Json?
  comments         BlogComment[]
  likesRecords     BlogLike[]
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([published])
  @@index([publishedAt])
  @@index([slug])
}

model BlogComment {
  id         String   @id @default(cuid())
  postId     String
  authorName String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
  author     User?    @relation(fields: [authorId], references: [id])
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  sessionId String?
  userId    String?
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([postId, sessionId])
  @@unique([postId, userId])
  @@index([postId])
}

model ShopCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  shops       Shop[]
}

model Shop {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  logo         String?
  coverImage   String?
  categoryId   String
  userId       String
  isActive     Boolean       @default(true)
  isVerified   Boolean       @default(false)
  address      String?
  city         String?
  phone        String?
  whatsapp     String?
  website      String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  province     String?
  reservations Reservation[]
  reviews      Review[]
  category     ShopCategory  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      ShopProfile?

  @@index([slug])
  @@index([categoryId])
  @@index([userId])
}

model ShopProfile {
  id           String   @id @default(cuid())
  shopId       String   @unique
  portfolio    String?
  priceRange   String?
  availability String?
  experience   String?
  tags         String[]
  socialLinks  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  images       Json?
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Reservation {
  id             String   @id @default(cuid())
  shopId         String
  userId         String
  clientName     String?
  clientEmail    String?
  clientPhone    String?
  clientWhatsapp String?
  date           DateTime
  message        String?
  status         String   @default("pending")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([userId])
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompetitionEntry {
  id               String               @id @default(cuid())
  title            String
  slug             String               @unique
  content          String
  excerpt          String?
  imageUrl         String?
  imageOrientation String?              @default("landscape")
  images           String[]
  tags             String[]
  published        Boolean              @default(false)
  status           PostStatus           @default(PENDING)
  views            Int                  @default(0)
  likes            Int                  @default(0)
  rewardAmount     Float                @default(0.0)
  firstTo200       Boolean              @default(false)
  rankWinner       Int?
  createdAt        DateTime             @default(now())
  publishedAt      DateTime?
  comments         CompetitionComment[]
  authorId         String
  author           User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likesRecords     CompetitionLike[]
}

model CompetitionComment {
  id        String           @id @default(uuid())
  content   String
  createdAt DateTime         @default(now())
  postId    String
  post      CompetitionEntry @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompetitionLike {
  id        String           @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime         @default(now())
  post      CompetitionEntry @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model CompetitionSettings {
  id          String   @id @default("global")
  isSuspended Boolean  @default(false)
  reason      String?  @default("Suspension temporaire du concours par manque d'implication de plusieurs candidats.")
  updatedAt   DateTime @updatedAt
}

model FairePart {
  id                String          @id @default(cuid())
  title             String
  slug              String          @unique
  imageUrl          String?
  eventType         String          @default("MARRIAGE")
  groomName         String?
  brideName         String?
  organizerName     String?
  announcementText  String          @db.Text
  eventDate         DateTime
  eventTime         String
  locationName      String
  mapsUrl           String?
  invitationLink    String?
  rsvpDeadline      DateTime?
  mobileMoneyNumber  String?
  mobileMoneyName    String?
  contactPhone      String?
  contactEmail      String?
  importantNote     String?         @db.Text
  
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relation optionnelle vers Event :
  eventId           String?
  event             Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)

  rsvps             FairePartRsvp[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// 👈 AJOUTÉ : Modèle pour les réponses/confirmations d'invités
model FairePartRsvp {
  id          String    @id @default(cuid())
  fairePartId String
  guestName   String
  guestEmail  String?
  guestPhone  String?
  status      String    @default("PENDING") // PENDING, CONFIRMED, DECLINED
  plusOne     Int       @default(0)
  message     String?   @db.Text
  createdAt   DateTime  @default(now())
  
  fairePart   FairePart @relation(fields: [fairePartId], references: [id], onDelete: Cascade)

  @@index([fairePartId])
}