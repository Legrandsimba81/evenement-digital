generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  emailVerifications EmailVerification[] // ✅
  image         String?
  password      String?
  phone         String?   @unique // 👈 rendu unique
  role          String    @default("USER")
  balance       Float         @default(0)
  transactions  Transaction[]
  isSuperAdmin   Boolean   @default(false)   // nouvel ajout
  eventLimits   Json?   // { "ANNIVERSAIRE": 50, "SOUTENANCE": null, ... } null = illimité
  events        Event[]
  accounts      Account[]
  sessions      Session[]
  collaborators EventCollaborator[]
  notifications Notification[]
  posts         BlogPost[]
  shops       Shop[]
  reservations Reservation[]
  reviews     Review[]
  comments      BlogComment[]
  likes         BlogLike[]
  logs          EventLog[] // ✅ relation inverse
  resetTokens   PasswordResetToken[] // ✅
  canCreateEvents Boolean @default(true) // ✅ nouveau champ
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id                String    @id @default(cuid())
  title             String
  type              String
  description       String?
  invitationText    String?
  program           String?
  location          String
  date              DateTime
  time              String
  imageUrl          String?
  invitationImageUrl String?
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guests            Guest[]
  messages          Message[]
  collaborators     EventCollaborator[]
  logs              EventLog[]
  slug              String    @unique
  whatsappNumber    String?
  invitationNumber  String?
  gateSecret        String?
  format          String?   @default("INVITATION") // "INVITATION" ou "BILLET"
  thesisTitle       String?   // pour les soutenances
  theme             Json?     // thème stocké en JSON
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}


model EventCollaborator {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventLog {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime  @default(now())

  @@index([eventId])
  @@index([userId])
}

model Guest {
  id                String   @id @default(cuid())
  title             String?
  firstName         String
  lastName          String
  status            String?  @default("en_attente")
  invitationType    String?  // "single" ou "couple" (par invité)
  invitationNumber  String?
  guestLevel        String?  // "SUPERVIP", "VIP", "STANDARD", ou personnalisé
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([firstName, lastName, eventId])
}

model Message {
  id            String    @id @default(cuid())
  content       String
  guestName     String
  guestId       String?
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "deposit" ou "payment"
  fullName     String?   // nom de l'utilisateur qui fait le dépôt
  operator    String?  // "mpesa" ou "airtel"
  countryCode String?  // "CD", "KE", "UG", "TZ", "RW", "BI"
  phoneNumber String?
  amount      Float
  currency    String   @default("USD")
  description String?
  provider    String?  // "pawapay"
  reference   String?  // référence PawaPay
  proofImage  String?  // URL Cloudinary de la capture
  status      String   @default("pending") // pending, completed, failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "info", "warning", "success", "error"
  title     String?
  message   String   @db.Text
  link      String?  // lien optionnel (vers un événement, une transaction, etc.)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}

model EmailVerification {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?
  imageUrl    String?
  metaTitle   String?
  metaDesc    String?
  tags        String[] // stocké comme tableau de texte
  imageOrientation String? @default("landscape") // "landscape" ou "portrait"
  images Json? // stockera un tableau d'URLs d'images secondaires
  published   Boolean  @default(false)
  publishedAt DateTime?
  views       Int      @default(0)
  likes       Int      @default(0)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    BlogComment[]
  likesRecords BlogLike[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
  @@index([slug])
}

model BlogComment {
  id         String   @id @default(cuid())
  content    String   @db.Text
  authorName String   // nom affiché
  authorId   String?  // si l'utilisateur est connecté
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  postId     String
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([postId])
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  sessionId String?  // pour les anonymes
  userId    String?  // pour les utilisateurs connectés
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull) // ✅ ajout
  createdAt DateTime @default(now())

  @@unique([postId, sessionId]) // empêcher un même visiteur de liker plusieurs fois
  @@unique([postId, userId])
  @@index([postId])
}

// ===================== MARKETPLACE / BOUTIQUES =====================
model ShopCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // nom d'icône (ex: 'music', 'camera', etc.)
  shops       Shop[]
  tags        String[] // ✅ ajoutez ce champ pour stocker les tags par catégorie
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?  // URL de l'image
  coverImage  String?  // URL de la bannière
  categoryId  String
  category    ShopCategory @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive    Boolean     @default(true)
  isVerified  Boolean     @default(false)
  address     String?
  city        String?
  phone       String?
  whatsapp    String?
  website     String?
  metadata    Json?       // horaires, réseaux sociaux, etc.
  profile     ShopProfile? // relation 1-1
  reservations Reservation[]
  reviews     Review[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([userId])
}

model ShopProfile {
  id          String   @id @default(cuid())
  shopId      String   @unique
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  portfolio   String?  // URL ou description du portfolio (peut être un tableau d'images JSON)
  priceRange  String?  // ex: "50-150$"
  availability String? // JSON: jours/horaires, ou texte libre
  experience  String?  // nombre d'années d'expérience, description
  tags        String[] // mots-clés
  images      Json?    // tableau d'URLs d'images du portfolio
  socialLinks Json?    // { facebook: "...", instagram: "...", etc. }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reservation {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime // date de la réservation
  message     String?
  status      String   @default("pending") // pending, confirmed, cancelled, completed
  metadata    Json?    // informations supplémentaires
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
  @@index([userId])
}

model Review {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      // 1-5 étoiles
  comment     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopId])
  @@index([userId])
}