generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  password           String?
  image              String?
  role               String               @default("USER")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  emailVerified      DateTime?
  canCreateEvents    Boolean              @default(true)
  phone              String?              @unique
  isSuperAdmin       Boolean              @default(false)
  balance            Float                @default(0)
  eventLimits        Json?
  accounts           Account[]
  comments           BlogComment[]
  likes              BlogLike[]
  posts              BlogPost[]
  competitionEntries CompetitionEntry[]  // 👈 AJOUTÉ ICI pour lier avec le modèle CompetitionEntry
  competitionLikes   CompetitionLike[]   // 👈 À AJOUTER
  competitionComments CompetitionComment[]
  emailVerifications EmailVerification[]
  events             Event[]
  collaborators      EventCollaborator[]
  collaboratorLimits Json?
  logs               EventLog[]
  notifications      Notification[]
  resetTokens        PasswordResetToken[]
  reservations       Reservation[]
  reviews            Review[]
  sessions           Session[]
  shops              Shop[]
  transactions       Transaction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id                 String              @id @default(cuid())
  title              String
  type               String
  description        String?
  invitationText     String?
  program            String?
  location           String
  date               DateTime
  time               String
  imageUrl           String?
  userId             String
  slug               String              @unique
  whatsappNumber     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  invitationImageUrl String?
  invitationNumber   String?
  locationAddress String?  // Adresse textuelle
  locationLat     Float?   // Latitude
  locationLng     Float?   // Longitude
  locationName    String?  // Nom du lieu (ex: "Salle des fêtes La Fontaine")
  locationUrl     String?  // Lien externe (ex: Google Maps)
  gateSecret         String?
  theme              Json?
  thesisTitle        String?
  format             String?             @default("INVITATION")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collaborators      EventCollaborator[]
  logs               EventLog[]
  guests             Guest[]
  messages           Message[]
}

model EventCollaborator {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventLog {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

model Guest {
  id               String   @id @default(cuid())
  title            String?
  firstName        String
  lastName         String
  eventId          String
  status           String?  @default("en_attente")
  invitationNumber String?
  invitationType   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  guestLevel       String?
  email            String?
  phone            String?
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([firstName, lastName, eventId])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  guestName String
  eventId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guestId   String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Float
  currency    String   @default("USD")
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  countryCode String?
  operator    String?
  phoneNumber String?
  proofImage  String?
  updatedAt   DateTime @updatedAt
  fullName    String?
  provider    String?
  reference   String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String?
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model BlogPost {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  excerpt          String?
  content          String
  imageUrl         String?
  authorId         String
  published        Boolean       @default(false)
  publishedAt      DateTime?
  views            Int           @default(0)
  likes            Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  metaTitle        String?
  metaDesc         String?
  tags             String[]
  imageOrientation String?       @default("landscape")
  images           Json?
  comments         BlogComment[]
  likesRecords     BlogLike[]
  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([published])
  @@index([publishedAt])
  @@index([slug])
}

model BlogComment {
  id         String   @id @default(cuid())
  postId     String
  authorName String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())
  author     User?    @relation(fields: [authorId], references: [id])
  post       BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model BlogLike {
  id        String   @id @default(cuid())
  postId    String
  sessionId String?
  userId    String?
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@unique([postId, sessionId])
  @@unique([postId, userId])
  @@index([postId])
}

model ShopCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[]
  shops       Shop[]
}

model Shop {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  logo         String?
  coverImage   String?
  categoryId   String
  userId       String
  isActive     Boolean       @default(true)
  isVerified   Boolean       @default(false)
  address      String?
  city         String?
  phone        String?
  whatsapp     String?
  website      String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  province     String?
  reservations Reservation[]
  reviews      Review[]
  category     ShopCategory  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      ShopProfile?

  @@index([slug])
  @@index([categoryId])
  @@index([userId])
}

model ShopProfile {
  id           String   @id @default(cuid())
  shopId       String   @unique
  portfolio    String?
  priceRange   String?
  availability String?
  experience   String?
  tags         String[]
  socialLinks  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  images       Json?
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Reservation {
  id              String   @id @default(cuid())
  shopId          String
  userId          String
  clientName      String?  // Nom du client
  clientEmail     String?  // Email du client
  clientPhone     String?  // Téléphone
  clientWhatsapp  String?  // WhatsApp
  date            DateTime
  message         String?
  status          String   @default("pending") // pending, accepted, rejected
  metadata        Json?    // pour stocker des infos supplémentaires si besoin
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([userId])
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}


model CompetitionEntry {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  content          String
  excerpt          String?
  imageUrl         String?
  imageOrientation String?         @default("landscape")
  images           String[]
  tags             String[]
  published        Boolean         @default(false)
  status           PostStatus      @default(PENDING)
  views            Int             @default(0)
  likes            Int             @default(0)
  rewardAmount     Float           @default(0.0) // Cumul des gains ($1 bonus de bienvenue + $20 (200 likes) + $50/$20/$10)
  firstTo200       Boolean         @default(false) // Indique si cet article a débloqué le bonus unique des 200 likes ($20)
  rankWinner       Int?            // 1, 2, ou 3 selon l'ordre d'atteinte des 1000 likes
  createdAt        DateTime        @default(now())
  publishedAt      DateTime?
  comments  CompetitionComment[] // Ajouter la relation

  authorId         String
  author           User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likesRecords     CompetitionLike[]
}

model CompetitionComment {
  id        String           @id @default(uuid())
  content   String
  createdAt DateTime         @default(now())
  
  postId    String
  post      CompetitionEntry @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId    String? 
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade) // 👈 AJOUTER LE '?' ICI
}

model CompetitionLike {
  id        String           @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime         @default(now())

  post      CompetitionEntry @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // Empêche un utilisateur d'aimer 2 fois le même article
  @@index([postId])
  @@index([userId])
}